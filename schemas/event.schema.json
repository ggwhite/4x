{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "4x Event",
  "description": "A single event in events.jsonl",
  "type": "object",
  "required": ["ts", "type"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "phase": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["conditional-pass-residual", "escalation", "feature-discovered", "force-done", "guard-fail", "health-check-failed", "hook", "phase-skipped", "phase-start", "run-end", "run-error", "run-output", "run-start", "self-mod-approved", "self-mod-detected", "transition"]
    },
    "role": { "type": "string" },
    "round": { "type": "integer" },
    "action": { "type": "string" },
    "cmd": { "type": "string" },
    "status": { "type": "string" },
    "detail": { "type": "string" },
    "runner": { "type": "string" },
    "model": { "type": "string" },
    "notify": {
      "type": "string",
      "description": "Notification level hint for dashboards; empty means no notification",
      "enum": ["success", "error", "warning"]
    },
    "tokens_used": { "type": "integer", "description": "本次 runner invocation 使用的 token 數量，僅 run-end event 填寫" },
    "cost_usd": { "type": "number", "description": "本次 runner invocation 花費（美元），僅 run-end event 填寫" },
    "duration_ms": { "type": "integer", "description": "本次 runner invocation 耗時（毫秒），僅 run-end event 填寫" },
    "index": { "type": "integer", "description": "同一 round 內平行執行的同 role 子任務序號（1-based），目前僅 deep-reviewer 平行 sub-reviewer 使用，用來讓 phase-start/run-end 正確配對" },
    "codex": {
      "type": ["object", "null"],
      "description": "codex runner 本次 invocation 的即時額度用量（primary_pct 5 小時窗、secondary_pct 週窗），僅 codex run-end event 填寫；claude 不填",
      "properties": {
        "primary_pct": { "type": "number" },
        "secondary_pct": { "type": "number" },
        "primary_resets_at": { "type": "integer" },
        "secondary_resets_at": { "type": "integer" }
      }
    }
  }
}
