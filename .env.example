# .env.example — 複製為 .env（已被 .gitignore 忽略）並填入實際值。
# 供 make dashboard-release（scripts/package-macos.sh + notarize-macos.sh）讀取。
# 詳細設定步驟見 docs/guide/dashboard.md → macOS release build。

# --- Code signing ---
# Developer ID Application 憑證的名稱（可用 `security find-identity -v -p codesigning` 查詢）
# 未設定時 package-macos.sh 會退回 ad-hoc 簽名（本地開發用，無法公證）。
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# --- Notarization（二選一）---

# A) App Store Connect API key（推薦）
NOTARY_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
NOTARY_KEY_ID="XXXXXXXXXX"
NOTARY_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# B) Apple ID + app-specific password（與 A 擇一，設定 A 時可留空）
# NOTARY_APPLE_ID="you@example.com"
# NOTARY_PASSWORD="abcd-efgh-ijkl-mnop"
# NOTARY_TEAM_ID="TEAMID"
