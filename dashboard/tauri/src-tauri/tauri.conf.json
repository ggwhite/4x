{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4x Live",
  "version": "0.1.0",
  "identifier": "com.ggwhite.4x.live",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "4x Live",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "externalBin": ["binaries/4x"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis-hooks.nsi"
      }
    }
  }
}
