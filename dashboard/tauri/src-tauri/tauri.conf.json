{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4x Live",
  "version": "0.1.0",
  "identifier": "com.ggwhite.4x.live",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "4x Live",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage"],
    "externalBin": ["binaries/4x"],
    "icon": ["icons/icon.png"]
  }
}
